<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="1040" viewBox="0 0 1200 1040" role="img" aria-labelledby="title desc">
  <title id="title">Portfolio website wireframe plan</title>
  <desc id="desc">Three page wireframes for Home, Projects and About/Contact, followed by palette and typography notes.</desc>
  <style>
    text{font-family:Arial,sans-serif;fill:#20302e}.title{font-size:30px;font-weight:bold}.page{font-size:21px;font-weight:bold}.label{font-size:15px}.small{font-size:13px;fill:#42534e}.box{fill:#fbfaf6;stroke:#52645d;stroke-width:2}.accent{fill:#dce9e2;stroke:#52645d;stroke-width:2}.hero{fill:#e8d8bf;stroke:#52645d;stroke-width:2}.line{stroke:#71847a;stroke-width:2}
  </style>
  <rect width="1200" height="1040" fill="#f4f1e9"/>
  <text x="48" y="52" class="title">Personal portfolio · rough wireframe</text>
  <text x="48" y="82" class="small">Shared header and navigation on every page · content stacks vertically on mobile</text>
  <!-- Home -->
  <g transform="translate(48 118)">
    <text x="0" y="0" class="page">01 · Home</text>
    <rect x="0" y="18" width="340" height="500" rx="8" class="box"/>
    <rect x="16" y="34" width="308" height="48" rx="5" class="accent"/><text x="28" y="64" class="label">Logo / name · Home · Work · About</text>
    <rect x="16" y="98" width="308" height="180" rx="5" class="hero"/><text x="30" y="136" class="label">INTRO / HERO</text><text x="30" y="166" class="small">Name + specialty (large headline)</text><text x="30" y="190" class="small">Short value statement</text><text x="30" y="232" class="small">[Explore work] button</text>
    <text x="16" y="312" class="label">SELECTED WORK</text>
    <rect x="16" y="326" width="148" height="128" rx="5" class="accent"/><text x="28" y="362" class="small">Project preview</text><text x="28" y="388" class="small">Image / title</text>
    <rect x="176" y="326" width="148" height="128" rx="5" class="accent"/><text x="188" y="362" class="small">Project preview</text><text x="188" y="388" class="small">Image / title</text>
    <rect x="16" y="468" width="308" height="34" rx="5" class="box"/><text x="28" y="491" class="small">Footer · copyright · social links</text>
  </g>
  <!-- Projects -->
  <g transform="translate(430 118)">
    <text x="0" y="0" class="page">02 · Projects / Work</text>
    <rect x="0" y="18" width="340" height="500" rx="8" class="box"/>
    <rect x="16" y="34" width="308" height="48" rx="5" class="accent"/><text x="28" y="64" class="label">Logo / name · Home · Work · About</text>
    <text x="20" y="120" class="label">PAGE INTRO</text><text x="20" y="150" class="small">Projects / Work headline</text><text x="20" y="174" class="small">One-line introduction</text>
    <rect x="16" y="194" width="308" height="84" rx="5" class="hero"/><text x="30" y="230" class="small">Project 1 · image + short result</text><text x="30" y="254" class="small">Role / year / case study link</text>
    <rect x="16" y="290" width="308" height="84" rx="5" class="accent"/><text x="30" y="326" class="small">Project 2 · image + short result</text><text x="30" y="350" class="small">Role / year / case study link</text>
    <rect x="16" y="386" width="308" height="84" rx="5" class="accent"/><text x="30" y="422" class="small">Project 3 · image + short result</text><text x="30" y="446" class="small">Role / year / case study link</text>
    <rect x="16" y="482" width="308" height="20" rx="5" class="box"/><text x="28" y="498" class="small">Footer · contact call to action</text>
  </g>
  <!-- About -->
  <g transform="translate(812 118)">
    <text x="0" y="0" class="page">03 · About / Contact</text>
    <rect x="0" y="18" width="340" height="500" rx="8" class="box"/>
    <rect x="16" y="34" width="308" height="48" rx="5" class="accent"/><text x="28" y="64" class="label">Logo / name · Home · Work · About</text>
    <rect x="16" y="98" width="308" height="112" rx="5" class="hero"/><text x="30" y="138" class="label">ABOUT INTRO</text><text x="30" y="170" class="small">Portrait / short bio</text>
    <text x="16" y="244" class="label">BACKGROUND + APPROACH</text><line x1="16" y1="260" x2="324" y2="260" class="line"/><line x1="16" y1="278" x2="292" y2="278" class="line"/><line x1="16" y1="296" x2="310" y2="296" class="line"/>
    <rect x="16" y="322" width="308" height="112" rx="5" class="accent"/><text x="30" y="362" class="label">CONTACT</text><text x="30" y="392" class="small">Email button · LinkedIn · GitHub</text>
    <rect x="16" y="450" width="308" height="52" rx="5" class="box"/><text x="28" y="482" class="small">Footer · copyright</text>
  </g>
  <rect x="48" y="680" width="1104" height="270" rx="10" fill="#fbfaf6" stroke="#52645d" stroke-width="2"/>
  <text x="76" y="724" class="page">Visual direction</text>
  <text x="76" y="770" class="label">Color palette</text>
  <rect x="220" y="748" width="54" height="36" rx="4" fill="#f4f1e9" stroke="#aaa"/><text x="284" y="772" class="small">Warm paper #F4F1E9 · deep evergreen #20302E</text>
  <rect x="220" y="798" width="54" height="36" rx="4" fill="#dce9e2" stroke="#aaa"/><text x="284" y="822" class="small">Soft sage #DCE9E2 · muted terracotta #B86E52 · ink #20302E</text>
  <text x="76" y="884" class="label">Type</text><text x="220" y="884" class="small">Headings: Georgia (expressive serif) · Body/UI: Arial or system sans-serif (clear and familiar)</text>
  <text x="76" y="920" class="small">Keep generous whitespace, strong contrast, and consistent spacing across all pages.</text>
</svg>
